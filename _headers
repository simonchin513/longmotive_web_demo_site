# Cloudflare Pages header rules.
#
# Only content-addressed / never-edited-in-place assets get the immutable
# year-long cache. HTML and the root-level *-viewer.js bundles deliberately
# keep the default (max-age=0, must-revalidate) so a deploy is picked up
# immediately.
#
# Because these responses are immutable, replacing an image, model or video
# means shipping it under a NEW filename. Overwriting one in place will leave
# returning visitors on the old copy for up to a year.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/uploads/*
  Cache-Control: public, max-age=31536000, immutable

/_ds/*
  Cache-Control: public, max-age=31536000, immutable

# The clean News URL previously answered a permanent redirect, and browsers
# keep those forever. Do not let anything retain this route again.
/news-events
  Cache-Control: no-store, max-age=0

/news-events.html
  Cache-Control: no-store, max-age=0

# HTTPS only, for a year, once a browser has been here.
#
# WITHOUT includeSubDomains, deliberately. mail, webmail, smtp, imap, pop,
# cpanel, autodiscover and ftp all resolve under longmotive-m.com and are
# Webteq's, not ours. Asserting HTTPS on their behalf would take the company's
# own webmail off the air for anyone who had visited this site, and an HSTS
# claim is cached for the full year whether or not it was true.
/*
  Strict-Transport-Security: max-age=31536000
